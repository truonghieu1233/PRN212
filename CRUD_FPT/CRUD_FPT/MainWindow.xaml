<Window x:Class="CRUD_FPT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRUD_FPT"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="CategoryID" Grid.Row="0" Grid.Column="0" Margin="10,5" VerticalAlignment="Center" FontSize="14"/>
        <TextBox x:Name="txtCategoryID" Grid.Row="0" Grid.Column="1" Margin="10,5" Height="25" VerticalAlignment="Center" Background="#F0F0F0" IsReadOnly="True" Text="1"/>

        <Label Content="CategoryName" Grid.Row="1" Grid.Column="0" Margin="10,5" VerticalAlignment="Center" FontSize="14"/>
        <TextBox x:Name="txtCategoryName" Grid.Row="1" Grid.Column="1" Margin="10,5" Height="25" VerticalAlignment="Center" Text="Beverages"/>

        <DataGrid x:Name="dgvCategories" Grid.Row="2" Grid.ColumnSpan="2" Margin="10,15" 
                  AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                  Background="DarkGray" RowHeaderWidth="25" AlternatingRowBackground="White" GridLinesVisibility="All"
                  SelectionChanged="dgvCategories_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="CategoryID" Binding="{Binding CategoryId}" Width="150"/>
                <DataGridTextColumn Header="CategoryName" Binding="{Binding CategoryName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button x:Name="btnInsert" Content="Insert" Width="100" Height="30" Margin="15,0" Click="btnInsert_Click"/>
            <Button x:Name="btnUpdate" Content="Update" Width="100" Height="30" Margin="15,0" Click="btnUpdate_Click"/>
            <Button x:Name="btnDelete" Content="Delete" Width="100" Height="30" Margin="15,0" Click="btnDelete_Click"/>
        </StackPanel>
    </Grid>
</Window>
